bits 16
org 0x7C00

start:
   ; Inicializar segmentos
   xor ax, ax
   mov ds, ax
   mov es, ax

   ; Guardar numero de unidad de arranque
   mov [boot_drive], dl

   ; Mostrar mensaje
   mov si, mensaje

imprimir:
   lodsb
   cmp al, 0
   je cargar_kernel

   mov ah, 0x0E
   int 0x10

   jmp imprimir


cargar_kernel:
   ; ES:BX = direccion donde se cargara el kernel
   mov ax, 0x0000
   mov es, ax
   mov bx, 0x8000

   ; BIOS: leer sectores del disco
   mov ah, 0x02
   mov al, 0x01
   mov ch, 0x00
   mov cl, 0x02
   mov dh, 0x00
   mov dl, [boot_drive]

   int 0x13

   jc error_disco

   ; Saltar al kernel
   jmp 0x0000:0x8000


error_disco:
   mov si, error

error_loop:
   lodsb
   cmp al, 0
   je detener

   mov ah, 0x0E
   int 0x10

   jmp error_loop


detener:
   cli
   hlt
   jmp detener


mensaje:
   db "ChildeOS Bootloader...", 0

error:
   db "Error leyendo Kernel!", 0


boot_drive:
   db 0


times 510 - ($ - $$) db 0
dw 0xAA55

